---
import { ClientRouter } from 'astro:transitions';
const siteTitle = "TouHouBlog"
---

<html lang="zh-CN">
<head>
    <link rel="stylesheet" href="/src/styles/global.css" />
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{siteTitle}</title>
    <ClientRouter />
</head>
<body class="bg-white text-gray-900">
<header class="bg-white shadow-sm p-4 fixed top-0 w-full z-50">
    <nav class="max-w-4xl mx-auto flex justify-between items-center">
        <a href="/" class="text-xl font-bold text-gray-900 no-underline">TouHouBlog</a>
        <div class="flex gap-4 items-center">
            <a href="/" class="text-gray-600 hover:text-gray-900 no-underline">首页</a>
            <a href="/archive" class="text-gray-600 hover:text-gray-900 no-underline">归档</a>
            <a href="/picture" class="text-gray-600 hover:text-gray-900 no-underline">图集</a>
            <a href="/talks" class="text-gray-600 hover:text-gray-900 no-underline">杂谈</a>
            <a href="/about" class="text-gray-600 hover:text-gray-900 no-underline">关于</a>
            <a href="/version" class="text-gray-600 hover:text-gray-900 no-underline">开发者日志</a>
            <span id="user-area"></span>
        </div>
    </nav>
</header>

<main class="p-6 pt-20"><slot /></main>

<script>
    // @ts-nocheck
    function decodeJwtPayload(token) {
        const base64Url = token.split('.')[1];
        const base64 = base64Url.replace(/-/g, '+').replace(/_/g, '/');
        const jsonPayload = decodeURIComponent(
            atob(base64).split('').map(function(c) {
                return '%' + ('00' + c.charCodeAt(0).toString(16)).slice(-2);
            }).join('')
        );
        return JSON.parse(jsonPayload);
    }

    function updateUserArea() {
        const token = localStorage.getItem('touhou_token');
        const userArea = document.getElementById('user-area');
        if (!userArea) return;
        if (token) {
            try {
                const payload = decodeJwtPayload(token);
                const avatar = payload.avatarUrl || 'https://picsum.photos/32?random=default';
                userArea.innerHTML = `<img src="${avatar}" class="w-[32px] h-[32px] rounded-full cursor-pointer object-cover border-2 border-transparent hover:border-gray-300 transition-colors" id="user-avatar" title="点击退出" />`;
                document.getElementById('user-avatar').addEventListener('click', function() {
                    if (confirm('确定退出登录吗？')) {
                        localStorage.removeItem('touhou_token');
                        window.location.reload();
                    }
                });
            } catch(e) {
                userArea.innerHTML = `<a href="/manage" class="text-gray-600 hover:text-gray-900 no-underline">登录</a>`;
            }
        } else {
            userArea.innerHTML = `<a href="/manage" class="text-gray-600 hover:text-gray-900 no-underline">登录</a>`;
        }
    }
    updateUserArea();
    document.addEventListener('astro:page-load', updateUserArea);
</script>
</body>
</html>