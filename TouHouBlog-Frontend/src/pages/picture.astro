---
import Layout from '../layouts/Layout.astro'
import PictureGrid from '../components/pages/PictureGrid.vue'
---

<Layout>
    <div class="max-w-6xl mx-auto px-4 py-8">
        <h1 class="text-6xl font-extrabold text-gray-900 tracking-widest text-center py-12">
            图集
        </h1>
        <p class="text-center text-base text-gray-400 mb-10">
            这里将收藏我喜欢的图片作品，敬请期待
        </p>
        <PictureGrid client:load />
    </div>
</Layout>