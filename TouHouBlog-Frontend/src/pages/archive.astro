---
import Layout from '../layouts/Layout.astro'
import ArchivePage from '../components/pages/ArchivePage.vue'
import CategoryList from '../components/pages/indexPage/CategoryList.vue'
import TagList from '../components/pages/indexPage/TagList.vue'
import MusicPlayer from '../components/pages/MusicPlayer.vue'
---

<Layout>
    <!-- 标题区域 -->
    <div class="text-center py-12">
        <h1 class="text-6xl font-extrabold text-gray-900 tracking-widest">归档与探索</h1>
        <p class="mt-4 text-base text-gray-400" id="totalArticles">共 0 篇研究</p>
        <div class="mt-6 flex justify-center">
            <input
                    id="searchInput"
                    type="text"
                    placeholder="搜索文章..."
                    class="w-80 px-4 py-2.5 border border-gray-200 rounded-full text-sm text-gray-700 placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-gray-300 focus:border-transparent bg-white shadow-sm"
                    @keyup.enter="handleSearch"
            />
        </div>
    </div>

    <!-- 三栏布局 -->
    <div class="flex gap-6 max-w-7xl mx-auto px-4">
        <aside class="w-56 flex-shrink-0">
            <div class="sticky top-24">
                <CategoryList client:load />
            </div>
        </aside>

        <main class="flex-1 max-w-[60%]">
            <ArchivePage client:load />
        </main>

        <aside class="w-56 flex-shrink-0">
            <div class="sticky top-24 space-y-4">
                <TagList client:load />
                <MusicPlayer client:only="vue" mode="mini" transition:persist />
            </div>
        </aside>
    </div>
</Layout>

<script>
    import axios from 'axios';

    const searchInput = document.getElementById('searchInput') as HTMLInputElement | null;
    const totalSpan = document.getElementById('totalArticles') as HTMLSpanElement | null;

    async function fetchTotal(keyword = '') {
        const params: Record<string, any> = { page: 1, pageSize: 1 };
        if (keyword) params.keyword = keyword;
        // 也可以从 URL 读取 categoryId / tagId，这里简化
        const res = await axios.get('/api/articles/list', { params });
        if (totalSpan) {
            totalSpan.textContent = `共 ${res.data.data.total} 篇研究`;
        }
    }

    fetchTotal();

    searchInput?.addEventListener('keyup', (e: KeyboardEvent) => {
        if (e.key === 'Enter') {
            const input = e.target as HTMLInputElement;
            const keyword = input.value.trim();
            fetchTotal(keyword);
            window.dispatchEvent(new CustomEvent('search-change', { detail: { keyword } }));
        }
    });
</script>