---
import Layout from '../layouts/Layout.astro'
import ArchivePage from '../components/pages/ArchivePage.vue'
import CategoryList from '../components/pages/CategoryList.vue'
import TagList from '../components/pages/TagList.vue'
import MusicPlayer from '../components/pages/MusicPlayer.vue'
---

<Layout>
    <!-- 标题区域：横跨整行，淡入动画 -->
    <div class="text-center py-12 fade-in-simple">
        <h1 class="archive-title">归档与探索</h1>
        <p class="archive-subtitle" id="totalArticles">共 … 篇研究</p>

        <div class="mt-6 flex justify-center items-center gap-3 flex-wrap">
            <a id="new-article-btn" href="/write" style="display:none"
               class="archive-write-btn">写文章</a>

            <div class="flex items-center gap-2">
                <input id="searchInput" type="text" placeholder="搜索文章..."
                       class="archive-search-input w-64" />
                <button id="search-btn" class="archive-search-btn">搜索</button>
            </div>
        </div>

        <div class="mt-4 flex justify-center">
            <div id="viewSwitch" class="archive-view-switch w-48">
                <div id="switchIndicator" class="archive-view-indicator left-0"></div>
                <button data-view="list" class="archive-view-btn active">文章列表</button>
                <button data-view="timeline" class="archive-view-btn">时间线</button>
            </div>
        </div>
    </div>

    <!-- 三栏布局 -->
    <div class="flex gap-6 max-w-7xl mx-auto px-4">
        <!-- 左侧栏：从左侧屏幕外滑入 -->
        <aside class="w-56 flex-shrink-0 slide-in-left">
            <div class="sticky top-24">
                <CategoryList client:load />
            </div>
        </aside>

        <main class="flex-1 max-w-[60%]">
            <ArchivePage client:load />
        </main>

        <!-- 右侧栏：从右侧屏幕外滑入 -->
        <aside class="w-56 flex-shrink-0 slide-in-right">
            <div class="sticky top-24 space-y-4">
                <TagList client:load />
                <MusicPlayer client:only="vue" mode="mini" transition:persist />
            </div>
        </aside>
    </div>
</Layout>

<script>
    // @ts-nocheck
        function initArchivePage() {
            const searchInput = document.getElementById('searchInput');
            const searchBtn = document.getElementById('search-btn');
            const totalSpan = document.getElementById('totalArticles');
            const writeBtn = document.getElementById('new-article-btn');
            const indicator = document.getElementById('switchIndicator');
            const switchButtons = document.querySelectorAll('#viewSwitch button');

            // 更新文章总数
            async function fetchTotal(keyword = '') {
                if (!totalSpan) return;
                const params = { page: '1', pageSize: '1' };
                if (keyword) params.keyword = keyword;
                const urlParams = new URLSearchParams(window.location.search);
                const cat = urlParams.get('categoryId');
                const tag = urlParams.get('tagId');
                if (cat && cat !== 'null') params.categoryId = cat;
                if (tag && tag !== 'null') params.tagId = tag;
                try {
                    const res = await fetch('/api/articles/list?' + new URLSearchParams(params).toString());
                    const data = await res.json();
                    if (data.code === 1 && totalSpan) {
                        totalSpan.textContent = `共 ${data.data.total} 篇研究`;
                        }
                    } catch (e) {
                    console.error('获取文章总数失败', e);
                    }
                }

            function performSearch() {
                const keyword = searchInput?.value.trim() || '';
                fetchTotal(keyword);
                window.dispatchEvent(new CustomEvent('search-change', { detail: { keyword } }));
                }

            // 避免重复绑定
            if (searchBtn && !searchBtn.__bound) {
                searchBtn.addEventListener('click', performSearch);
                searchBtn.__bound = true;
                }
            if (searchInput && !searchInput.__bound) {
                searchInput.addEventListener('keyup', (e) => {
                    if (e.key === 'Enter') performSearch();
                    });
                searchInput.__bound = true;
                }

            function setWriteButton() {
                if (!writeBtn) return;
                const token = localStorage.getItem('touhou_token');
                if (token) {
                    try {
                        const payload = JSON.parse(atob(token.split('.')[1]));
                        writeBtn.style.display = payload.role === 1 ? 'inline-block' : 'none';
                        } catch (e) {
                        writeBtn.style.display = 'none';
                        }
                    } else {
                    writeBtn.style.display = 'none';
                    }
                }

            function setSwitchStyle(view) {
                if (!indicator || !switchButtons.length) return;
                indicator.style.transform = view === 'timeline' ? 'translateX(100%)' : 'translateX(0)';
                switchButtons.forEach(btn => {
                    const isActive = (btn.dataset.view === view);
                    btn.classList.toggle('active', isActive);
                    });
                }

            function switchView(view) {
                window.__archiveView = view;
                setSwitchStyle(view);
                window.dispatchEvent(new CustomEvent('archive-view-change', { detail: { view } }));
                }

            switchButtons.forEach(btn => {
                if (!btn.__bound) {
                    btn.addEventListener('click', () => switchView(btn.dataset.view));
                    btn.__bound = true;
                    }
                });

            // 初始化
            const savedView = window.__archiveView || 'list';
            setSwitchStyle(savedView);
            fetchTotal();
            setWriteButton();
            }

        initArchivePage();
        document.addEventListener('astro:page-load', initArchivePage);
</script>
<style>
    .archive-search-input {
        background: var(--input-bg);
        border: 1px solid var(--card-border);
        color: var(--text-primary);
        backdrop-filter: blur(8px);
        -webkit-backdrop-filter: blur(8px);
        transition: background 0.3s ease, border-color 0.3s ease, color 0.3s ease;
    }

    .archive-search-input::placeholder {
        color: var(--text-muted);
    }

    /* 暗色模式下，placeholder 更亮，接近白色 */
    :global([data-theme="dark"]) .archive-search-input::placeholder {
        color: rgba(255, 255, 255, 0.8) !important;
    }

    .archive-search-input:focus {
        border-color: var(--input-focus-border);
        background: var(--input-bg);
        box-shadow: 0 0 0 3px rgba(192, 132, 252, 0.15);
        outline: none;
    }
</style>