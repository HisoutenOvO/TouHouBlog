---
import { ClientRouter } from 'astro:transitions';
import GlobalModal from '../components/common/GlobalModal.vue';
import BackgroundCarousel from '../components/common/BackgroundCarousel.vue';
import SakuraPetals from '../components/common/SakuraPetals.vue';
import ClickRipple from '../components/common/ClickRipple.vue';
import LoadingBar from '../components/common/LoadingBar.vue';
import ParticleBackground from '../components/common/ParticleBackground.vue';
import SplashScreen from '../components/common/SplashScreen.vue';
const siteTitle = "TouHouBlog"
import '../styles/global.css';
import '../styles/md-editor-v3.css';
---

<html lang="zh-CN">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{siteTitle}</title>
    <ClientRouter />
    <script>
        (function() {
            const saved = localStorage.getItem('touhou_theme');
            const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
            const theme = saved || (prefersDark ? 'dark' : 'light');
            document.documentElement.setAttribute('data-theme', theme);
        })();
    </script>
    <link rel="icon" type="image/png" sizes="32x32" href="/images/favicon-32x32.png">
    <link rel="icon" type="image/png" sizes="16x16" href="/images/favicon-16x16.png">
    <link rel="apple-touch-icon" sizes="180x180" href="/images/apple-touch-icon.png">
</head>
<body>
<BackgroundCarousel client:load transition:persist />
<SplashScreen client:load />
<SakuraPetals client:load transition:persist/>
<ParticleBackground client:load transition:persist />
<header class="glass-navbar p-4 fixed top-0 w-full z-50">
    <nav class="max-w-4xl mx-auto flex justify-between items-center">
        <a href="/" class="site-title no-underline">TouHouBlog</a>
        <div class="flex gap-4 items-center">
            <a href="/" class="nav-link">首页</a>
            <a href="/archive" class="nav-link">归档</a>
            <a href="/picture" class="nav-link">图集</a>
            <a href="/talks" class="nav-link">杂谈</a>
            <a href="/about" class="nav-link">关于</a>
            <span id="todo-link" style="display:none;"></span>
            <a href="/version" class="nav-link">开发者日志</a>
            <button onclick="toggleTheme()" class="nav-link theme-toggle-btn" title="切换主题">
                <span id="theme-icon"></span>
            </button>
            <span id="user-area"></span>
        </div>
    </nav>
</header>
<ClickRipple client:load transition:persist />
<LoadingBar client:load transition:persist />
<main class="p-6 pt-20"><slot /></main>
<GlobalModal client:load />

<script>
    // @ts-nocheck
    window.decodeJwtPayload = function(token) {
        const base64Url = token.split('.')[1];
        const base64 = base64Url.replace(/-/g, '+').replace(/_/g, '/');
        const jsonPayload = decodeURIComponent(
            atob(base64).split('').map(function(c) {
                return '%' + ('00' + c.charCodeAt(0).toString(16)).slice(-2);
            }).join('')
        );
        return JSON.parse(jsonPayload);
    };

    window.applyTheme = function() {
        const saved = localStorage.getItem('touhou_theme');
        const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
        const theme = saved || (prefersDark ? 'dark' : 'light');
        document.documentElement.setAttribute('data-theme', theme);
    };

    window.toggleTheme = function() {
        const current = document.documentElement.getAttribute('data-theme');
        const next = current === 'dark' ? 'light' : 'dark';
        document.documentElement.setAttribute('data-theme', next);
        localStorage.setItem('touhou_theme', next);
        window.updateThemeIcon();
    };

    window.updateThemeIcon = function() {
        const theme = document.documentElement.getAttribute('data-theme');
        const icon = document.getElementById('theme-icon');
        if (icon) {
            const moonSvg = '<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"/></svg>';
            const sunSvg = '<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2"/><path d="M12 20v2"/><path d="m4.93 4.93 1.41 1.41"/><path d="m17.66 17.66 1.41 1.41"/><path d="M2 12h2"/><path d="M20 12h2"/><path d="m6.34 17.66-1.41 1.41"/><path d="m19.07 4.93-1.41 1.41"/></svg>';
            icon.innerHTML = theme === 'dark' ? sunSvg : moonSvg;
            icon.style.color = theme === 'dark' ? '#fbbf24' : '#6b7280';
            icon.style.display = 'flex';
            icon.style.alignItems = 'center';
            icon.style.justifyContent = 'center';
            icon.style.height = '100%';
        }
    };

    window.$alert = (msg) => {
        return new Promise((resolve) => {
            window.dispatchEvent(new CustomEvent('global-alert', {
                detail: { message: msg, resolve }
            }));
        });
    };

    window.$confirm = (msg) => {
        return new Promise((resolve) => {
            window.dispatchEvent(new CustomEvent('global-confirm', {
                detail: { message: msg, resolve }
            }));
        });
    };

    window.updateUserArea = function() {
        const token = localStorage.getItem('touhou_token');
        const userArea = document.getElementById('user-area');
        const todoLink = document.getElementById('todo-link');

        if (!userArea) return;

        if (token) {
            try {
                const payload = window.decodeJwtPayload(token);
                const avatar = payload.avatarUrl || 'https://picsum.photos/32?random=default';

                // 站长显示待办入口，非站长隐藏
                if (todoLink) {
                    if (payload.role === 1) {
                        todoLink.innerHTML = '<a href="/todo" class="nav-link">待办</a>';
                        todoLink.style.display = 'inline-flex';
                    } else {
                        todoLink.innerHTML = '';
                        todoLink.style.display = 'none';
                    }
                }

                userArea.innerHTML = `<img src="${avatar}" class="w-[32px] h-[32px] rounded-full cursor-pointer object-cover border-2 border-transparent hover:border-gray-300 transition-colors" id="user-avatar" title="点击退出" />`;

                const avatarEl = document.getElementById('user-avatar');
                if (avatarEl) {
                    avatarEl.addEventListener('click', async function() {
                        const confirmed = await window.$confirm('确定退出登录吗？');
                        if (confirmed) {
                            localStorage.removeItem('touhou_token');
                            window.location.reload();
                        }
                    });
                }
            } catch(e) {
                if (todoLink) {
                    todoLink.innerHTML = '';
                    todoLink.style.display = 'none';
                }
                userArea.innerHTML = `<a href="/manage" class="login-nav-btn">登录</a>`;
            }
        } else {
            if (todoLink) {
                todoLink.innerHTML = '';
                todoLink.style.display = 'none';
            }
            userArea.innerHTML = `<a href="/manage" class="login-nav-btn">登录</a>`;
        }
    };

    window.applyTheme();
    window.updateUserArea();
    window.updateThemeIcon();

    document.addEventListener('astro:page-load', () => {
        window.applyTheme();
        window.updateUserArea();
        window.updateThemeIcon();
    });
</script>
</body>
</html>