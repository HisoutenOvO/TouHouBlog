---
import Layout from '../../layouts/Layout.astro'
import ArticleDetail from '../../components/pages/ArticleDetail.vue'
import MusicPlayer from '../../components/pages/MusicPlayer.vue'
export const prerender = false

const { id } = Astro.params
---

<Layout>
    <ArticleDetail client:load articleId={id} />
    <MusicPlayer key={Astro.url.pathname} client:load mode="hidden" />
</Layout>