---
import Layout from '../../layouts/Layout.astro'
import TalkDetail from '../../components/pages/TalkDetail.vue'
import MusicPlayer from '../../components/pages/MusicPlayer.vue'
export const prerender = false

const { id } = Astro.params
---

<Layout>
    <TalkDetail client:load talkId={id} />
    <MusicPlayer key={Astro.url.pathname} client:load mode="hidden" />
</Layout>