<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="BlogBack.mapper.CommentMapper">
    <select id="pageQuery" resultType="BlogBack.pojo.vo.CommentListVO">
        select id,user_id,content,nickname,create_time
        from comment
        where article_id = #{articleId}
    </select>
</mapper>