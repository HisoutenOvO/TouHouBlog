---
import Layout from '../layouts/Layout.astro'
import ArchivePage from '../components/pages/ArchivePage.vue'
import CategoryList from '../components/pages/indexPage/CategoryList.vue'
import TagList from '../components/pages/indexPage/TagList.vue'
import MusicPlayer from '../components/pages/MusicPlayer.vue'
---

<Layout>
    <!-- 标题区域（完全由 Astro 控制） -->
    <div class="text-center py-12">
        <h1 class="text-6xl font-extrabold text-gray-900 tracking-widest">归档与探索</h1>
        <p class="mt-4 text-base text-gray-400" id="totalArticles">共 … 篇研究</p>
        <div class="mt-6 flex justify-center items-center gap-4">
            <input
                    id="searchInput"
                    type="text"
                    placeholder="搜索文章..."
                    class="w-80 px-4 py-2.5 border border-gray-200 rounded-full text-sm text-gray-700 placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-gray-300 focus:border-transparent bg-white shadow-sm"
            />
            <a id="new-article-btn" href="/write" style="display:none"
               class="px-4 py-2 bg-gray-800 text-white rounded-full text-sm hover:bg-gray-900 no-underline">
                写文章
            </a>
        </div>
        <div class="mt-4 flex justify-center">
            <div class="inline-flex items-center bg-gray-100 rounded-full p-1 relative w-48" id="viewSwitch">
                <div id="switchIndicator" class="absolute top-0 bottom-0 w-1/2 bg-white rounded-full shadow transition-all duration-200 left-0"></div>
                <button data-view="list" class="flex-1 py-1.5 text-sm font-medium rounded-full transition-colors relative z-10 text-gray-900">文章列表</button>
                <button data-view="timeline" class="flex-1 py-1.5 text-sm font-medium rounded-full transition-colors relative z-10 text-gray-500">时间线</button>
            </div>
        </div>
    </div>

    <div class="flex gap-6 max-w-7xl mx-auto px-4">
        <aside class="w-56 flex-shrink-0">
            <div class="sticky top-24">
                <CategoryList client:load />
            </div>
        </aside>

        <main class="flex-1 max-w-[60%]">
            <ArchivePage client:load />
        </main>

        <aside class="w-56 flex-shrink-0">
            <div class="sticky top-24 space-y-4">
                <TagList client:load />
                <MusicPlayer client:only="vue" mode="mini" transition:persist />
            </div>
        </aside>
    </div>
</Layout>

<script>
    //@ts-nocheck
    // 每次 astro 页面加载完成时执行
    document.addEventListener('astro:page-load', () => {
        // 通知组件重新获取总数
        window.dispatchEvent(new CustomEvent('refresh-article-total'))
        const switchContainer = document.getElementById('viewSwitch')
        const indicator = document.getElementById('switchIndicator')
        const buttons = switchContainer?.querySelectorAll('button')

        function setSwitchStyle(view) {
            if (!indicator || !buttons) return
            indicator.style.transform = view === 'timeline' ? 'translateX(100%)' : 'translateX(0)'
            buttons[0].classList.toggle('text-gray-900', view === 'list')
            buttons[0].classList.toggle('text-gray-500', view !== 'list')
            buttons[1].classList.toggle('text-gray-900', view === 'timeline')
            buttons[1].classList.toggle('text-gray-500', view !== 'timeline')
            }

        function switchView(view) {
            window.__archiveView = view
            setSwitchStyle(view)
            window.dispatchEvent(new CustomEvent('archive-view-change', { detail: { view } }))
            }

        // 初始化
        setSwitchStyle(window.__archiveView || 'list')

        // 绑定点击事件
        buttons?.forEach(btn => {
            btn.addEventListener('click', () => {
                switchView(btn.dataset.view)
                })
            })
        // 确保写文章按钮也重新检查
        const btn = document.getElementById('new-article-btn')
        if (btn) {
            const token = localStorage.getItem('touhou_token')
            if (token) {
                try {
                    const payload = JSON.parse(atob(token.split('.')[1]))
                    btn.style.display = (payload.role === 1) ? 'inline-block' : 'none'
                } catch (e) { btn.style.display = 'none' }
            } else { btn.style.display = 'none' }
        }
    })

    // 监听总数变化事件，每次触发都重新从 DOM 获取元素，防止引用失效
    window.addEventListener('article-total', function(e) {
        const totalSpan = document.getElementById('totalArticles')
        if (totalSpan) {
            totalSpan.textContent = '共 ' + e.detail.total + ' 篇研究'
        }
    })
</script>