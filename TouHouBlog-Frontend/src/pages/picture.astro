---
import Layout from '../layouts/Layout.astro'
import PictureGrid from '../components/pages/PictureGrid.vue'
import MusicPlayer from '../components/pages/MusicPlayer.vue'
---

<Layout>
    <div class="max-w-6xl mx-auto px-4 py-8">
        <div class="text-center pt-4 pb-8 fade-in-simple">
            <h1 class="archive-title">图集</h1>
            <p class="archive-subtitle">这里将收藏我喜欢的图片作品，敬请欣赏</p>
        </div>
        <PictureGrid client:load />
    </div>
    <MusicPlayer client:only="vue" transition:persist mode="hidden" /></Layout>