---
// src/pages/index.astro
import Layout from '../layouts/Layout.astro'
import HomeIntro from "../components/pages/indexPage/HomeIntro.vue";
import CategoryList from '../components/pages/CategoryList.vue';
import RecentArticles from '../components/pages/indexPage/RecentArticles.vue';
import SiteStates from '../components/pages/indexPage/SiteStates.vue';
import TagList from '../components/pages/TagList.vue';
import LatestTalk from '../components/pages/indexPage/LatestTalk.vue';
import MusicPlayer from '../components/pages/MusicPlayer.vue';  // 重新导入
import HomeImageCarousel from '../components/pages/HomeImageCarousel.vue';
const recentProps = { pageSize: 5, search: "", categoryId: null, tagId: null };
---
<Layout>
	<div class="px-6 py-8">
		<!-- 顶部区域：左边图片 + 中间音乐（正方形） + 右边杂谈 -->
		<div class="flex gap-6 mb-8 min-h-[28rem]">
			<div class="w-[28rem] h-[28rem] flex-shrink-0">
				<HomeImageCarousel client:load />
			</div>

			<div class="w-[28rem] h-[28rem] flex items-center justify-center flex-shrink-0">
				<MusicPlayer client:only="vue" mode="full" transition:persist />
			</div>

			<div class="flex-1 min-w-0">
				<LatestTalk client:load />
			</div>
		</div>

		<div class="flex gap-6">
			<div class="flex-1">
				<RecentArticles client:load {...recentProps} />
			</div>

			<aside class="w-80 flex flex-col gap-6">
				<HomeIntro client:load />
				<SiteStates client:load />
				<CategoryList client:load />
				<TagList client:load />
			</aside>
		</div>
	</div>
</Layout>